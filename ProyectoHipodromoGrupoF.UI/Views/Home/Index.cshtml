@{
    ViewData["Title"] = "Dashboard Principal";
    var alertas = ViewBag.AlertasDetalle as IEnumerable<ProyectoHipodromoGrupoF.Modelo.AlertaVeterinaria>
                  ?? new List<ProyectoHipodromoGrupoF.Modelo.AlertaVeterinaria>();
}

<div class="row mb-4">
    <!-- Welcome Card -->
    <div class="col-md-8 mb-4">
        <div class="glass-card p-4 h-100 d-flex flex-column justify-content-center"
             style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(30, 41, 59, 0.8));">
            <h2 class="text-white fw-bold">Bienvenido al Hipódromo Nacional, @User.Identity?.Name</h2>
            <p class="text-secondary mt-2 mb-4">
                Conectado como: <strong class="text-white">
                @(User.IsInRole("1") ? "Propietario" :
                  User.IsInRole("2") ? "Administrador" :
                  User.IsInRole("3") ? "Encargado de Establo" :
                  User.IsInRole("4") ? "Veterinario" : "Usuario")
                </strong>
            </p>
            <div class="d-flex flex-wrap gap-3">
                @if(User.IsInRole("1") || User.IsInRole("2"))
                {
                    <a asp-controller="Eventos" asp-action="Index" class="btn btn-primary-custom px-4">
                        <i class="fa-solid fa-calendar me-2"></i>Ver Eventos
                    </a>
                }
                @if(User.IsInRole("1") || User.IsInRole("2") || User.IsInRole("3"))
                {
                    <a asp-controller="Inscripciones" asp-action="Index" class="btn btn-primary-custom px-4">
                        <i class="fa-solid fa-clipboard-list me-2"></i>Inscripciones
                    </a>
                }
                <a asp-controller="Equinos" asp-action="Index" class="btn btn-secondary-custom px-4">
                    <i class="fa-solid fa-horse-head me-2"></i>Ver Equinos
                </a>
            </div>
        </div>
    </div>

    <!-- Quick KPIs -->
    <div class="col-md-4 mb-4">
        <div class="row h-100">
            <div class="col-6 mb-3">
                <div class="glass-panel p-3 d-flex flex-column align-items-center justify-content-center text-center h-100">
                    <i class="fa-solid fa-horse fs-2 text-primary mb-1"></i>
                    <h3 class="text-white m-0 fw-bold">@(ViewBag.TotalCaballos ?? 0)</h3>
                    <small class="text-secondary">Caballos</small>
                </div>
            </div>
            <div class="col-6 mb-3">
                <div class="glass-panel p-3 d-flex flex-column align-items-center justify-content-center text-center h-100">
                    <i class="fa-solid fa-flag-checkered fs-2 text-accent mb-1"></i>
                    <h3 class="text-white m-0 fw-bold">@(ViewBag.EventosProgramados ?? 0)</h3>
                    <small class="text-secondary">Eventos</small>
                </div>
            </div>
            <div class="col-6">
                <div class="glass-panel p-3 d-flex flex-column align-items-center justify-content-center text-center h-100">
                    <i class="fa-solid fa-file-invoice-dollar fs-2 text-success mb-1"></i>
                    <h4 class="text-white m-0 fw-bold" style="font-size:1rem;">
                        ₡@((ViewBag.CuentasPorCobrar as double? ?? 0).ToString("N0"))
                    </h4>
                    <small class="text-secondary">Por Cobrar</small>
                </div>
            </div>
            <div class="col-6">
                <a asp-controller="Equinos" asp-action="HistorialVeterinario" style="text-decoration:none;">
                    <div class="glass-panel p-3 d-flex flex-column align-items-center justify-content-center text-center h-100
                                @(alertas.Any() ? "border border-danger border-opacity-50" : "")">
                        <i class="fa-solid fa-stethoscope fs-2 @(alertas.Any() ? "text-danger" : "text-secondary") mb-1"></i>
                        <h3 class="@(alertas.Any() ? "text-danger" : "text-white") m-0 fw-bold">@(ViewBag.AlertasVet ?? 0)</h3>
                        <small class="text-secondary">Alertas Vet.</small>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Alertas Veterinarias en tiempo real (2% rúbrica) -->
    <div class="col-md-6 mb-4">
        <div class="glass-panel p-4 h-100">
            <h5 class="text-white mb-4">
                <i class="fa-solid fa-bell text-accent me-2"></i> Alertas Veterinarias
                @if(alertas.Any())
                {
                    <span class="badge bg-danger rounded-pill ms-2">@alertas.Count()</span>
                }
            </h5>
            @if(!alertas.Any())
            {
                <div class="text-center py-4">
                    <i class="fa-solid fa-circle-check fa-2x text-success mb-2"></i>
                    <p class="text-secondary">Todos los caballos tienen certificaciones vigentes.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush bg-transparent">
                    @foreach(var alerta in alertas)
                    {
                        <div class="list-group-item bg-transparent text-white border-secondary px-0 py-3">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1">
                                        <i class="fa-solid fa-triangle-exclamation @(alerta.EstaVencida ? "text-danger" : "text-warning") me-2"></i>
                                        <strong>@alerta.NombreCaballo</strong>
                                        <code class="text-secondary ms-1">(@alerta.CodigoCaballo)</code>
                                    </h6>
                                    <p class="mb-0 small text-secondary">
                                        Vence: @alerta.FechaVencimientoCertificacion.ToString("dd/MM/yyyy")
                                    </p>
                                </div>
                                @if(alerta.EstaVencida)
                                { <span class="badge bg-danger">Vencida</span> }
                                else
                                { <span class="badge bg-warning text-dark">@alerta.DiasRestantes días</span> }
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <a asp-controller="Equinos" asp-action="HistorialVeterinario" class="btn btn-sm btn-outline-warning">
                        <i class="fa-solid fa-notes-medical me-1"></i> Ver Historial Completo
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Accesos Rápidos -->
    <div class="col-md-6 mb-4">
        <div class="glass-panel p-4 h-100">
            <h5 class="text-white mb-4">
                <i class="fa-solid fa-bolt text-primary me-2"></i> Accesos Rápidos
            </h5>
            <div class="d-grid gap-3">
                @if(User.IsInRole("2") || User.IsInRole("4"))
                {
                    <a asp-controller="Equinos" asp-action="HistorialVeterinario" class="btn btn-outline-primary text-start">
                        <i class="fa-solid fa-notes-medical me-2"></i> Registrar Control Veterinario
                    </a>
                }
                @if(User.IsInRole("1") || User.IsInRole("2") || User.IsInRole("3"))
                {
                    <a asp-controller="Inscripciones" asp-action="Index" class="btn btn-outline-secondary text-start">
                        <i class="fa-solid fa-clipboard-list me-2"></i> Gestionar Inscripciones
                    </a>
                }
                @if(User.IsInRole("1") || User.IsInRole("2"))
                {
                    <a asp-controller="Facturacion" asp-action="Index" class="btn btn-outline-success text-start">
                        <i class="fa-solid fa-file-invoice-dollar me-2"></i> Ver Facturación
                    </a>
                }
                @if(User.IsInRole("2") || User.IsInRole("3"))
                {
                    <a asp-controller="Inventario" asp-action="Index" class="btn btn-outline-info text-start">
                        <i class="fa-solid fa-box-open me-2"></i> Revisar Inventario
                    </a>
                }
            </div>
        </div>
    </div>
</div>

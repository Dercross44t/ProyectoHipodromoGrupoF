@model IEnumerable<ProyectoHipodromoGrupoF.Modelo.Suministro>
@{
    ViewData["Title"] = "Gestión de Suministros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-secondary m-0">Control de inventario, alimentos y suministros médicos.</p>
    @if(User.IsInRole("2") || User.IsInRole("3"))
    {
        <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#nuevoSuministroModal">
            <i class="fa-solid fa-box-open me-2"></i> Nuevo Suministro
        </button>
    }
</div>

<!-- Nav Tabs -->
<ul class="nav nav-pills mb-4 border-bottom border-secondary pb-3">
  <li class="nav-item">
    <a class="nav-link active bg-transparent text-primary fw-bold" asp-action="Index">Suministros en Stock</a>
  </li>
  <li class="nav-item">
    <a class="nav-link text-secondary" asp-action="Alimentacion">Registro de Alimentación</a>
  </li>
</ul>

<div class="glass-panel p-4">
    <table class="table table-glass w-100">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre del Suministro</th>
                <th>Proveedor</th>
                <th>Stock</th>
                <th>Fecha Ingreso</th>
                <th>Tipo</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.CodigoProveedor</td>
                    <td>
                        @if(item.CantidadDisponible < 20) {
                            <span class="text-danger fw-bold"><i class="fa-solid fa-arrow-down me-1"></i>@item.CantidadDisponible</span>
                        } else {
                            <span class="text-success fw-bold">@item.CantidadDisponible</span>
                        }
                    </td>
                    <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if(item.IdCatTipoSuministro == 1) { <span class="badge bg-secondary">Alimento</span> }
                        else if(item.IdCatTipoSuministro == 2) { <span class="badge bg-info text-dark">Medicamento</span> }
                        else { <span class="badge bg-light text-dark">Equipo</span> }
                    </td>
                    <td class="text-end">
                        @if(User.IsInRole("2"))
                        {
                            <form asp-action="EliminarSuministro" method="post" style="display:inline;"
                                  onsubmit="return confirm('¿Eliminar el suministro @item.Nombre?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="codigo" value="@item.Codigo" />
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal -->
@if(User.IsInRole("2") || User.IsInRole("3"))
{
<div class="modal fade" id="nuevoSuministroModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content glass-card border-0">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Registrar Suministro</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form asp-action="InsertarSuministro" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label text-white">Nombre</label>
            <input type="text" name="Nombre" class="form-control form-control-glass" required maxlength="50">
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Código Proveedor</label>
            <input type="text" name="CodigoProveedor" class="form-control form-control-glass" maxlength="10">
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-white">Stock Inicial</label>
                <input type="number" name="CantidadDisponible" class="form-control form-control-glass" required min="0">
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-white">Fecha Ingreso</label>
                <input type="date" name="FechaIngreso" class="form-control form-control-glass" required value="@DateTime.Today.ToString("yyyy-MM-dd")">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Tipo de Suministro</label>
            <select name="IdCatTipoSuministro" class="form-control form-control-glass" required>
                <option value="1">Alimento</option>
                <option value="2">Medicamento</option>
                <option value="3">Equipo</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary-custom">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>
}

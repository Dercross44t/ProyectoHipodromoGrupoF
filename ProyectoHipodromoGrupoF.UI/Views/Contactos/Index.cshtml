@model ProyectoHipodromoGrupoF.Modelo.ContactoViewModel

@{
    ViewData["Title"] = "Contactos";

    var personas = ViewBag.Personas as List<ProyectoHipodromoGrupoF.Modelo.Persona> ?? new();
    var proveedores = ViewBag.Proveedores as List<ProyectoHipodromoGrupoF.Modelo.Proveedor> ?? new();
    var tiposTelefono = ViewBag.TiposTelefono as List<ProyectoHipodromoGrupoF.Modelo.CatalogoItem> ?? new();
    var tiposCorreo = ViewBag.TiposCorreo as List<ProyectoHipodromoGrupoF.Modelo.CatalogoItem> ?? new();
}

<p class="text-secondary mb-4">
    Administración de teléfonos y correos electrónicos de personas y proveedores.
</p>

<ul class="nav nav-pills mb-4 border-bottom border-secondary pb-3" id="contactosTabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active bg-transparent text-primary fw-bold"
                data-bs-toggle="pill"
                data-bs-target="#tabPersonas"
                type="button">
            Contactos de Personas
        </button>
    </li>

    <li class="nav-item">
        <button class="nav-link text-secondary"
                data-bs-toggle="pill"
                data-bs-target="#tabProveedores"
                type="button">
            Contactos de Proveedores
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabPersonas">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-white m-0">Teléfonos de Personas</h4>

            <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#modalTelefonoPersona">
                <i class="fa-solid fa-phone me-2"></i> Nuevo Teléfono
            </button>
        </div>

        <div class="glass-panel p-0 overflow-hidden mb-5">
            <table class="table table-glass w-100 mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Persona</th>
                        <th>Número</th>
                        <th>Tipo</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var t in Model.TelefonosPersonas)
                    {
                        var persona = personas.FirstOrDefault(p => p.Cedula == t.Cedula);
                        var nombrePersona = persona != null ? $"{persona.Nombre1} {persona.Apellido1} {persona.Apellido2}" : t.Cedula;
                        var tipo = tiposTelefono.FirstOrDefault(x => x.Id == t.IdCatTipoTelefono)?.Nombre ?? t.IdCatTipoTelefono.ToString();

                        <tr>
                            <td><code class="text-accent">@t.Codigo</code></td>
                            <td>@nombrePersona (@t.Cedula)</td>
                            <td>@t.Numero</td>
                            <td><span class="badge bg-secondary">@tipo</span></td>
                        </tr>
                    }

                    @if (!Model.TelefonosPersonas.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-4">
                                No hay teléfonos de personas registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-white m-0">Correos Electrónicos de Personas</h4>

            <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#modalCorreoPersona">
                <i class="fa-solid fa-envelope me-2"></i> Nuevo Correo
            </button>
        </div>

        <div class="glass-panel p-0 overflow-hidden mb-5">
            <table class="table table-glass w-100 mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Persona</th>
                        <th>Correo</th>
                        <th>Tipo</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var c in Model.CorreosPersonas)
                    {
                        var persona = personas.FirstOrDefault(p => p.Cedula == c.Cedula);
                        var nombrePersona = persona != null ? $"{persona.Nombre1} {persona.Apellido1} {persona.Apellido2}" : c.Cedula;
                        var tipo = tiposCorreo.FirstOrDefault(x => x.Id == c.IdCatTipoCorreo)?.Nombre ?? c.IdCatTipoCorreo.ToString();

                        <tr>
                            <td><code class="text-accent">@c.Codigo</code></td>
                            <td>@nombrePersona (@c.Cedula)</td>
                            <td>@c.Correo</td>
                            <td><span class="badge bg-secondary">@tipo</span></td>
                        </tr>
                    }

                    @if (!Model.CorreosPersonas.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-4">
                                No hay correos de personas registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade" id="tabProveedores">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-white m-0">Teléfonos de Proveedores</h4>


        </div>

        <div class="glass-panel p-0 overflow-hidden mb-5">
            <table class="table table-glass w-100 mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Proveedor</th>
                        <th>Número</th>
                        <th>Tipo</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var t in Model.TelefonosProveedores)
                    {
                        var proveedor = proveedores.FirstOrDefault(p => p.Codigo == t.CodigoProveedor);
                        var nombreProveedor = proveedor != null ? proveedor.Nombre : t.CodigoProveedor;
                        var tipo = tiposTelefono.FirstOrDefault(x => x.Id == t.IdCatTipoTelefono)?.Nombre ?? t.IdCatTipoTelefono.ToString();

                        <tr>
                            <td><code class="text-accent">@t.Codigo</code></td>
                            <td>@nombreProveedor (@t.CodigoProveedor)</td>
                            <td>@t.Numero</td>
                            <td><span class="badge bg-secondary">@tipo</span></td>
                        </tr>
                    }

                    @if (!Model.TelefonosProveedores.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-4">
                                No hay teléfonos de proveedores registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-white m-0">Correos Electrónicos de Proveedores</h4>

            <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#modalCorreoProveedor">
                <i class="fa-solid fa-envelope me-2"></i> Nuevo Correo
            </button>
        </div>

        <div class="glass-panel p-0 overflow-hidden mb-5">
            <table class="table table-glass w-100 mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Proveedor</th>
                        <th>Correo</th>
                        <th>Tipo</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var c in Model.CorreosProveedores)
                    {
                        var proveedor = proveedores.FirstOrDefault(p => p.Codigo == c.CodigoProveedor);
                        var nombreProveedor = proveedor != null ? proveedor.Nombre : c.CodigoProveedor;
                        var tipo = tiposCorreo.FirstOrDefault(x => x.Id == c.IdCatTipoCorreo)?.Nombre ?? c.IdCatTipoCorreo.ToString();

                        <tr>
                            <td><code class="text-accent">@c.Codigo</code></td>
                            <td>@nombreProveedor (@c.CodigoProveedor)</td>
                            <td>@c.Correo</td>
                            <td><span class="badge bg-secondary">@tipo</span></td>
                        </tr>
                    }

                    @if (!Model.CorreosProveedores.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-4">
                                No hay correos de proveedores registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL TELEFONO PERSONA -->
<div class="modal fade" id="modalTelefonoPersona" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content glass-card border-0">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">Registrar Teléfono de Persona</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="InsertarTelefonoPersona" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white">Persona *</label>
                        <select name="Cedula" class="form-control form-control-glass" required>
                            <option value="">— Seleccione persona —</option>

                            @foreach (var p in personas)
                            {
                                <option value="@p.Cedula">@p.Nombre1 @p.Apellido1 @p.Apellido2 (@p.Cedula)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white">Número *</label>
                        <input type="text" name="Numero" class="form-control form-control-glass" required pattern="[0-9]{8}" maxlength="8">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white">Tipo *</label>
                        <select name="IdCatTipoTelefono" class="form-control form-control-glass" required>
                            <option value="">— Seleccione tipo —</option>

                            @foreach (var t in tiposTelefono)
                            {
                                <option value="@t.Id">@t.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>


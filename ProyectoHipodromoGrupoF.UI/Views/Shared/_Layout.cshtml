<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hipódromo Nacional</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- FontAwesome (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoHipodromoGrupoF.UI.styles.css" asp-append-version="true" />
</head>
<body>
    
    <!-- Sidebar Navigation -->
    <nav id="sidebar">
        <div class="sidebar-header">
            <i class="fa-solid fa-horse-head"></i> Hipódromo
        </div>
        <ul class="sidebar-menu">
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-chart-pie fa-fw"></i> Dashboard
                </a>
            </li>

            @if(User.IsInRole("2"))
            {
                <li>
                    <a asp-controller="Personas" asp-action="Index">
                        <i class="fa-solid fa-users fa-fw"></i> Usuarios
                    </a>
                </li>
            }

            @if(User.IsInRole("1") || User.IsInRole("2") || User.IsInRole("3") || User.IsInRole("4"))
            {
                <li>
                    <a asp-controller="Equinos" asp-action="Index">
                        <i class="fa-solid fa-horse fa-fw"></i> Equinos &amp; Establos
                        @if(ViewBag.AlertasVet != null && (int)ViewBag.AlertasVet > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-1" title="Alertas veterinarias pendientes">@ViewBag.AlertasVet</span>
                        }
                    </a>
                </li>
            }

            @if(User.IsInRole("1") || User.IsInRole("2") || User.IsInRole("3"))
            {
                <li>
                    <a asp-controller="Inscripciones" asp-action="Index">
                        <i class="fa-solid fa-clipboard-list fa-fw"></i> Inscripciones
                    </a>
                </li>
            }

            @if(User.IsInRole("1") || User.IsInRole("2"))
            {
                <li>
                    <a asp-controller="Eventos" asp-action="Index">
                        <i class="fa-solid fa-flag-checkered fa-fw"></i> Eventos &amp; Carreras
                    </a>
                </li>
                <li>
                    <a asp-controller="Resultados" asp-action="Index">
                        <i class="fa-solid fa-trophy fa-fw"></i> Resultados
                    </a>
                </li>
            }

            @if(User.IsInRole("2") || User.IsInRole("3"))
            {
                <li>
                    <a asp-controller="Inventario" asp-action="Index">
                        <i class="fa-solid fa-box-open fa-fw"></i> Inventario
                    </a>
                </li>
            }


            @if(User.IsInRole("2"))
            {
                <li>
                    <a asp-controller="Proveedores" asp-action="Index">
                        <i class="fa-solid fa-truck-fast fa-fw"></i> Proveedores
                    </a>
                </li>
                <li>
                    <a asp-controller="Facturacion" asp-action="Index">
                        <i class="fa-solid fa-file-invoice-dollar fa-fw"></i> Facturación
                    </a>
                </li>
            }
            @if(User.IsInRole("1"))
            {
                <li>
                    <a asp-controller="Facturacion" asp-action="MisFacturas">
                        <i class="fa-solid fa-file-invoice-dollar fa-fw"></i> Mis Facturas
                    </a>
                </li>
            }

            <li class="mt-4">
                <a asp-controller="Auth" asp-action="Logout" class="text-danger">
                    <i class="fa-solid fa-sign-out-alt fa-fw"></i> Cerrar Sesión
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div id="main-content">
        <header class="mb-4 d-flex justify-content-between align-items-center">
            <h2 class="m-0 text-white" style="font-family: 'Outfit', sans-serif;">@ViewData["Title"]</h2>
            <div class="user-profile d-flex align-items-center gap-3">
                <div class="text-end">
                    <div class="fw-bold text-white">@User.Identity?.Name</div>
                    <div class="text-secondary small">
                        @(User.IsInRole("1") ? "Propietario" : 
                          User.IsInRole("2") ? "Administrador" : 
                          User.IsInRole("3") ? "Encargado de Establo" : 
                          User.IsInRole("4") ? "Veterinario" : "Usuario")
                    </div>
                </div>
                <div class="rounded-circle bg-secondary d-flex justify-content-center align-items-center" style="width: 45px; height: 45px;">
                    <i class="fa-solid fa-user text-white"></i>
                </div>
            </div>
        </header>

        <!-- Mensajes de éxito / error globales -->
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 mb-4" role="alert"
                 style="background: rgba(16,185,129,0.15); color: #10b981; border-left: 4px solid #10b981 !important;">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert"
                 style="background: rgba(239,68,68,0.15); color: #ef4444; border-left: 4px solid #ef4444 !important;">
                <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

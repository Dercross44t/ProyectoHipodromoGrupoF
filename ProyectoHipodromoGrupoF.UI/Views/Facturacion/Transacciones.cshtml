@model IEnumerable<ProyectoHipodromoGrupoF.Modelo.HistorialTransaccion>
@{
    ViewData["Title"] = "Historial de Pagos";
    var facturas    = ViewBag.Facturas    as List<ProyectoHipodromoGrupoF.Modelo.Factura>        ?? new();
    var metodos     = ViewBag.MetodosPago as List<ProyectoHipodromoGrupoF.Modelo.CatalogoItem>   ?? new();
}

<!-- Tabs -->
<ul class="nav nav-pills mb-4 border-bottom border-secondary pb-3">
    <li class="nav-item"><a class="nav-link text-secondary" asp-action="Index">Facturas Emitidas</a></li>
    <li class="nav-item"><a class="nav-link active bg-transparent text-primary fw-bold" asp-action="Transacciones">Historial de Pagos</a></li>
</ul>

<div class="glass-panel p-0 overflow-hidden">
    <table class="table table-glass w-100 mb-0">
        <thead>
            <tr>
                <th>Código</th>
                <th>Factura</th>
                <th>Fecha de Pago</th>
                <th>Monto</th>
                <th>Método de Pago</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><code class="text-accent">@t.Codigo</code></td>
                    <td><a class="text-accent text-decoration-none"><i class="fa-solid fa-file-invoice me-1"></i>@t.CodigoFactura</a></td>
                    <td>@t.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="fw-bold text-success">₡@t.Monto.ToString("N2")</td>
                    <td>@(metodos.FirstOrDefault(m => m.Id == t.IdCatMetodoPago)?.Nombre ?? t.IdCatMetodoPago.ToString())</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-secondary py-5">
                    <i class="fa-solid fa-money-bill fa-2x mb-2 d-block opacity-25"></i>
                    No hay transacciones registradas.
                </td></tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    function cargarTotalFactura(codigoFactura) {
        const sel  = document.getElementById('selectFacturaTx');
        const opt  = sel.options[sel.selectedIndex];
        const monto = opt?.dataset?.total ?? '';
        document.getElementById('inputMontoTx').value = monto ? parseFloat(monto).toFixed(2) : '';
    }
</script>
}

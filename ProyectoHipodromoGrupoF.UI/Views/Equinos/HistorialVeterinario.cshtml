@model IEnumerable<ProyectoHipodromoGrupoF.Modelo.HistorialVeterinario>
@{
    ViewData["Title"] = "Historial Veterinario";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-secondary m-0">Registros médicos y certificaciones sanitarias de los caballos.</p>
    <button class="btn btn-primary-custom" onclick="validarPermisoRegistrarHistorial()" id="btnNuevoCaballo">
        <i class="fa-solid fa-plus me-2"></i> Registrar Historial Veterinario
    </button>
</div>

<!-- Nav Tabs -->
<div class="d-flex gap-4 border-bottom border-secondary mb-4 pb-3">
    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Equinos" asp-action="Index">
        Caballos Registrados
    </a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Establos" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Equinos" asp-action="Establos">
        Distribución de Establos
    </a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "HistorialVeterinario" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Equinos" asp-action="HistorialVeterinario">
        Historial Veterinario
    </a>
</div>

<div class="glass-panel p-4">
    <table class="table table-glass w-100">
        <thead>
            <tr>
                <th>Código</th>
                <th>Caballo</th>
                <th>Veterinario</th>
                <th>Diagnóstico</th>
                <th>Fecha Revisión</th>
                <th>Vencimiento Cert.</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var vencida  = item.FechaVencimientoCertificacion < DateTime.Today;
                var urgente  = !vencida && (item.FechaVencimientoCertificacion - DateTime.Today).TotalDays <= 7;
                <tr>
                    <td class="fw-bold">@item.Codigo</td>
                    <td><i class="fa-solid fa-horse-head text-secondary me-1"></i>@item.CodigoCaballo</td>
                    <td>@item.CodigoVeterinario</td>
                    <td><small>@(item.Diagnostico?.Length > 40 ? item.Diagnostico[..40] + "…" : item.Diagnostico)</small></td>
                    <td>@item.FechaRevision.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaVencimientoCertificacion.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (vencida)
                        {
                            <span class="badge badge-inactive"><i class="fa-solid fa-triangle-exclamation me-1"></i>Vencida</span>
                        }
                        else if (urgente)
                        {
                            <span class="badge badge-warning"><i class="fa-solid fa-clock me-1"></i>Por vencer</span>
                        }
                        else
                        {
                            <span class="badge badge-active"><i class="fa-solid fa-circle-check me-1"></i>Vigente</span>
                        }
                    </td>
                    <td class="text-end">
                        @if(User.IsInRole("4"))
                        {
                            <form asp-action="EliminarHistorial" method="post" style="display:inline;"
                                  onsubmit="return confirm('¿Eliminar este registro veterinario?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="codigo" value="@item.Codigo" />
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Eliminar">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Nuevo Registro Veterinario -->
@if(User.IsInRole("4"))
{
<div class="modal fade" id="nuevoHistorialModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content glass-card border-0">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white"><i class="fa-solid fa-notes-medical text-primary me-2"></i>Nuevo Registro Veterinario</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form asp-action="InsertarHistorial" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="row">
           <label class="form-label text-white">Caballo *</label>
           <select name="CodigoCaballo" class="form-control form-control-glass" required>
           <option value="">— Seleccione un caballo —</option>
              @foreach (var c in ViewBag.Caballos)
               {
                <option value="@c.Codigo">@c.Nombre (@c.Codigo)</option>
               }
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Diagnóstico</label>
            <textarea name="Diagnostico" class="form-control form-control-glass" rows="2" maxlength="200"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Tratamiento</label>
            <textarea name="Tratamiento" class="form-control form-control-glass" rows="2" maxlength="200"></textarea>
          </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Estado del Caballo *</label>
                            <select name="IdCatEstadoCaballo" class="form-control form-control-glass" required>
                                <option value="">— Seleccione estado —</option>
                                @foreach (var e in ViewBag.EstadosCaballo)
                                {
                                    <option value="@e.Id">@e.Nombre</option>
                                }
                            </select>
                        </div>
          <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-white">Fecha de Revisión</label>
                <input type="date" name="FechaRevision" class="form-control form-control-glass" required
                       value="@DateTime.Today.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-white">Vencimiento Certificación</label>
                <input type="date" name="FechaVencimientoCertificacion" class="form-control form-control-glass" required>
            </div>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary-custom"><i class="fa-solid fa-save me-1"></i>Guardar Registro</button>
        </div>
      </form>
    </div>
  </div>
</div>
}

 @section Scripts {
<script>
            function validarPermisoRegistrarHistorial() {
            const esVeterinario = '@User.IsInRole("4")'.toLowerCase() === 'true';

            if (!esVeterinario) {
                alert('No posee permisos para registrar historiales veterinarios.');
                return;
            }

            const modalElement = document.getElementById('nuevoHistorialModal');

            if (!modalElement) {
                alert('No se encontró el modal de registro de historial veterinario.');
                return;
            }

            const modal = new bootstrap.Modal(modalElement);
            modal.show();
        }
</script>
}
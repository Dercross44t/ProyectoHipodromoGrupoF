@model IEnumerable<ProyectoHipodromoGrupoF.Modelo.Caballo>
@{
    ViewData["Title"] = "Gestión de Caballos";
    var sexos        = ViewBag.Sexos       as List<ProyectoHipodromoGrupoF.Modelo.CatalogoItem> ?? new();
    var razas        = ViewBag.Razas       as List<ProyectoHipodromoGrupoF.Modelo.CatalogoItem> ?? new();
    var estados      = ViewBag.Estados     as List<ProyectoHipodromoGrupoF.Modelo.CatalogoItem> ?? new();
    var propietarios  = ViewBag.Propietarios as List<ProyectoHipodromoGrupoF.Modelo.Propietario>  ?? new();
    var establos      = ViewBag.Establos     as List<ProyectoHipodromoGrupoF.Modelo.Establo>       ?? new();
    var personasMap   = ViewBag.PersonasMap  as List<ProyectoHipodromoGrupoF.Modelo.Persona>       ?? new();
    var esPropietario = User.IsInRole("1");
    var codigoPropio  = ViewBag.CodigoPropietarioActual?.ToString() ?? "";
}

<!-- Nav Tabs -->
<div class="d-flex gap-4 border-bottom border-secondary mb-4 pb-3">
    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Equinos" asp-action="Index">
        Caballos Registrados
    </a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Establos" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Equinos" asp-action="Establos">
        Distribución de Establos
    </a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "HistorialVeterinario" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Equinos" asp-action="HistorialVeterinario">
        Historial Veterinario
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-secondary m-0">
        @if (esPropietario) { <text>Mis caballos registrados en el hipódromo.</text> }
        else { <text>Listado global de caballos registrados.</text> }
    </p>
    <button class="btn btn-primary-custom" onclick="validarPermisoRegistrarCaballo()" id="btnNuevoCaballo">
        <i class="fa-solid fa-plus me-2"></i> Registrar Caballo
    </button>
</div>

<!-- Tabla -->
<div class="glass-panel p-0 overflow-hidden">
    <table class="table table-glass w-100 mb-0">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Raza</th>
                <th>Sexo</th>
                <th>Fecha Nacimiento</th>
                <th>Peso (kg)</th>
                <th>Propietario</th>
                <th>Establo</th>
                <th>Estado</th>
                @if (User.IsInRole("1") || User.IsInRole("2"))
                { <th class="text-end">Acciones</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code class="text-accent">@c.Codigo</code></td>
                    <td>@c.Nombre</td>
                    <td>@(razas.FirstOrDefault(r => r.Id == c.IdCatRaza)?.Nombre ?? c.IdCatRaza.ToString())</td>
                    <td>@(sexos.FirstOrDefault(s => s.Id == c.IdCatSexo)?.Nombre ?? c.IdCatSexo.ToString())</td>
                    <td>@c.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td>@c.Peso.ToString("N1")</td>
                    <td>
                        @{
                            var prop = propietarios.FirstOrDefault(p => p.Codigo == c.CodigoPropietario);
                            var persona = prop != null ? personasMap.FirstOrDefault(pm => pm.Cedula == prop.Cedula) : null;
                            var nombrePropietario = persona != null ? $"{persona.Nombre1} {persona.Apellido1}" : c.CodigoPropietario;
                        }
                        <span class="text-secondary">@nombrePropietario</span>
                    </td>

                    <td>
                        @{
                            var est = establos.FirstOrDefault(e => e.Codigo == c.CodigoEstablo);
                            var nombreEstablo = est != null && !string.IsNullOrEmpty(est.Nombre)
                                ? est.Nombre
                                : string.IsNullOrWhiteSpace(c.CodigoEstablo)
                                    ? "Pendiente asignación"
                                    : c.CodigoEstablo;
                        }
                        <span class="badge bg-secondary">@nombreEstablo</span>
                    </td>

                    <td>
                        @{
                            var estadoNombre = c.IdCatEstadoCaballo.HasValue
                                ? estados.FirstOrDefault(e => e.Id == c.IdCatEstadoCaballo.Value)?.Nombre ?? "Sin estado"
                                : "Pendiente revisión";

                            var badgeCls = c.IdCatEstadoCaballo == 1
                                ? "badge-active"
                                : c.IdCatEstadoCaballo == 2
                                    ? "bg-warning text-dark"
                                    : "bg-secondary";
                        }
                        <span class="badge @badgeCls">@estadoNombre</span>
                    </td>
                    @if (User.IsInRole("1") || User.IsInRole("2"))
                    {
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary border-0 me-1"
                                    onclick="abrirEditarCaballo('@c.Codigo','@c.Nombre','@c.CodigoPropietario','@c.CodigoEstablo',@c.IdCatSexo,@c.IdCatRaza,@c.Peso.ToString(System.Globalization.CultureInfo.InvariantCulture),@c.IdCatEstadoCaballo,'@c.FechaNacimiento.ToString("yyyy-MM-dd")')"
                                    id="btnEditarCaballo_@c.Codigo">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            @if (User.IsInRole("1"))
                            {
                                <button class="btn btn-sm btn-outline-danger border-0"
                                        onclick="confirmarEliminarCaballo('@c.Codigo','@c.Nombre')"
                                        id="btnEliminarCaballo_@c.Codigo">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            }
                        </td>
                    }
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center text-secondary py-5">
                    <i class="fa-solid fa-horse fa-2x mb-2 d-block opacity-25"></i>
                    No hay caballos registrados.
                </td></tr>
            }
        </tbody>
    </table>
</div>

<!-- MODAL INSERTAR -->
<div class="modal fade" id="insertarCaballoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content glass-card border-0">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white"><i class="fa-solid fa-horse me-2"></i>Registrar Caballo</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form asp-action="InsertarCaballo" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-white">Nombre del caballo *</label>
                    <input type="text" name="Nombre" class="form-control form-control-glass" required maxlength="50" id="inputNombreCaballo">
                </div>
                <div class="col-md-6">
                    <label class="form-label text-white">Fecha de nacimiento *</label>
                    <input type="date" name="FechaNacimiento" class="form-control form-control-glass" required
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" id="inputFechaNacCaballo">
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white">Sexo *</label>
                    <select name="IdCatSexo" class="form-control form-control-glass" required id="selectSexoCaballo">
                        <option value="">— Seleccione —</option>
                        @foreach (var s in sexos) { <option value="@s.Id">@s.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white">Raza *</label>
                    <select name="IdCatRaza" class="form-control form-control-glass" required id="selectRazaCaballo">
                        <option value="">— Seleccione —</option>
                        @foreach (var r in razas) { <option value="@r.Id">@r.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white">Peso (kg) *</label>
                    <input type="text" name="Peso" class="form-control form-control-glass" required pattern="^\d*([.,]\d+)?$" inputmode="decimal" oninput="this.value = this.value.replace('.', ',');" id="inputPesoCaballo">
                </div>
                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                El establo será asignado posteriormente por el administrador o encargado de establo.
                                El estado del caballo será definido por el veterinario.
                            </div>
                        </div>
                @if (esPropietario)
                {
                    <input type="hidden" name="CodigoPropietario" value="@codigoPropio" />
                }
                else
                {
                    <div class="col-md-4">
                        <label class="form-label text-white">Propietario *</label>
                        <select name="CodigoPropietario" class="form-control form-control-glass" required id="selectPropietarioCaballo">
                            <option value="">— Seleccione —</option>
                            @foreach (var p in propietarios) 
                            { 
                                var pers = personasMap.FirstOrDefault(pm => pm.Cedula == p.Cedula);
                                var nom = pers != null ? $"{pers.Nombre1} {pers.Apellido1}" : p.Codigo;
                                <option value="@p.Codigo">@p.Codigo - @nom</option> 
                            }
                        </select>
                    </div>
                }
            </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary-custom" id="btnGuardarCaballo">
              <i class="fa-solid fa-floppy-disk me-1"></i> Guardar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL EDITAR -->
<div class="modal fade" id="editarCaballoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content glass-card border-0">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white"><i class="fa-solid fa-pen me-2"></i>Editar Caballo</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form asp-action="ActualizarCaballo" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Codigo" id="editCodigo">
        <div class="modal-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label text-white">Seleccionar caballo a editar *</label>
                    <select class="form-control form-control-glass" id="editSelectCaballo" onchange="seleccionarCaballoEditar(this)">
                        <option value="">— Seleccione —</option>
                        @foreach (var c in Model) { <option value="@c.Codigo" data-nombre="@c.Nombre" data-prop="@c.CodigoPropietario"
                            data-establo="@c.CodigoEstablo" data-sexo="@c.IdCatSexo" data-raza="@c.IdCatRaza"
                            data-peso="@c.Peso" data-estado="@c.IdCatEstadoCaballo"
                            data-fecha="@c.FechaNacimiento.ToString("yyyy-MM-dd")">@c.Nombre (@c.Codigo)</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-white">Nombre *</label>
                    <input type="text" name="Nombre" id="editNombre" class="form-control form-control-glass" required maxlength="50">
                </div>
                <div class="col-md-6">
                    <label class="form-label text-white">Fecha de nacimiento *</label>
                    <input type="date" name="FechaNacimiento" id="editFecha" class="form-control form-control-glass" required max="@DateTime.Today.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white">Sexo *</label>
                    <select name="IdCatSexo" id="editSexo" class="form-control form-control-glass" required>
                        @foreach (var s in sexos) { <option value="@s.Id">@s.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white">Raza *</label>
                    <select name="IdCatRaza" id="editRaza" class="form-control form-control-glass" required>
                        @foreach (var r in razas) { <option value="@r.Id">@r.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white">Peso (kg) *</label>
                    <input type="text" name="Peso" id="editPeso" class="form-control form-control-glass" required pattern="^\d*([.,]\d+)?$" inputmode="decimal" oninput="this.value = this.value.replace('.', ',');">
                </div>
                @if (esPropietario)
                {
                    <input type="hidden" name="CodigoPropietario" id="editPropietario" value="@codigoPropio">
                }
                else
                {
                    <div class="col-md-4">
                        <label class="form-label text-white">Propietario *</label>
                        <select name="CodigoPropietario" id="editPropietario" class="form-control form-control-glass" required>
                            <option value="">— Seleccione —</option>
                            @foreach (var p in propietarios) 
                            { 
                                var pers = personasMap.FirstOrDefault(pm => pm.Cedula == p.Cedula);
                                var nom = pers != null ? $"{pers.Nombre1} {pers.Apellido1}" : p.Codigo;
                                <option value="@p.Codigo">@p.Codigo - @nom</option> 
                            }
                        </select>
                    </div>
                }
            </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary-custom">
              <i class="fa-solid fa-floppy-disk me-1"></i> Actualizar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL ELIMINAR -->
@if (User.IsInRole("1"))
{
<div class="modal fade" id="eliminarCaballoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content glass-card border-0">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white"><i class="fa-solid fa-trash me-2 text-danger"></i>Eliminar Caballo</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
          <label class="form-label text-white mb-2">Seleccionar caballo a eliminar</label>
                    <select class="form-control form-control-glass mb-3" id="elimSelectCaballo" onchange="seleccionarCaballoEliminar(this)">
              <option value="">— Seleccione —</option>
              @foreach (var c in Model) { <option value="@c.Codigo" data-nombre="@c.Nombre">@c.Nombre (@c.Codigo)</option> }
          </select>
          <div class="glass-card p-3" style="background:rgba(239,68,68,0.1); border-left:3px solid #ef4444;" id="elimConfirm" style="display:none">
              <p class="text-secondary mb-0">¿Confirmas que deseas eliminar el caballo <strong class="text-white" id="elimNombreCaballo"></strong>? Esta acción no se puede deshacer.</p>
          </div>
      </div>
      <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
          <form asp-action="EliminarCaballo" method="post" style="display:inline;" id="formEliminarCaballo">
              @Html.AntiForgeryToken()
              <input type="hidden" name="codigo" id="elimCodigoCaballo">
              <button type="submit" class="btn btn-danger" id="btnConfirmarEliminarCaballo" disabled>
                  <i class="fa-solid fa-trash me-1"></i> Eliminar
              </button>
          </form>
      </div>
    </div>
  </div>
</div>
}

@section Scripts {
<script>
    // Prellenar modal EDITAR desde botón de tabla
    function abrirEditarCaballo(codigo, nombre, prop, establo, sexo, raza, peso, estado, fecha) {
        document.getElementById('editCodigo').value = codigo;
        document.getElementById('editNombre').value = nombre;
        document.getElementById('editFecha').value  = fecha;
        document.getElementById('editPeso').value   = String(peso).replace('.', ',');
        setSelectValue('editSexo', sexo);
        setSelectValue('editRaza', raza);
        setSelectValue('editEstado', estado);
        setSelectValue('editEstadoDisabled', estado);
        setSelectValue('hiddenEstado', estado);
        setSelectValue('editPropietario', prop);
        setSelectValue('editEstablo', establo);
        // Sync el select del modal edit
        var sel = document.getElementById('editSelectCaballo');
        if(sel) sel.value = codigo;
        new bootstrap.Modal(document.getElementById('editarCaballoModal')).show();
    }

    // Cuando se selecciona en el dropdown del modal editar
    function seleccionarCaballoEditar(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (!opt.value) return;
        document.getElementById('editCodigo').value    = opt.value;
        document.getElementById('editNombre').value    = opt.dataset.nombre;
        document.getElementById('editFecha').value     = opt.dataset.fecha;
        document.getElementById('editPeso').value      = String(opt.dataset.peso).replace('.', ',');
        setSelectValue('editSexo',       opt.dataset.sexo);
        setSelectValue('editRaza',       opt.dataset.raza);
        setSelectValue('editEstado',     opt.dataset.estado);
        setSelectValue('editEstadoDisabled', opt.dataset.estado);
        setSelectValue('hiddenEstado',   opt.dataset.estado);
        setSelectValue('editPropietario',opt.dataset.prop);
        setSelectValue('editEstablo',    opt.dataset.establo);
    }

    function confirmarEliminarCaballo(codigo, nombre) {
        document.getElementById('elimCodigoCaballo').value  = codigo;
        document.getElementById('elimNombreCaballo').innerText = nombre;
        document.getElementById('elimSelectCaballo').value  = codigo;
        document.getElementById('elimConfirm').style.display = 'block';
        document.getElementById('btnConfirmarEliminarCaballo').disabled = false;
        new bootstrap.Modal(document.getElementById('eliminarCaballoModal')).show();
    }

    function seleccionarCaballoEliminar(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (!opt.value) {
            document.getElementById('btnConfirmarEliminarCaballo').disabled = true;
            document.getElementById('elimConfirm').style.display = 'none';
            return;
        }
        document.getElementById('elimCodigoCaballo').value    = opt.value;
        document.getElementById('elimNombreCaballo').innerText = opt.dataset.nombre;
        document.getElementById('elimConfirm').style.display  = 'block';
        document.getElementById('btnConfirmarEliminarCaballo').disabled = false;
    }

    function setSelectValue(id, value) {
        var el = document.getElementById(id);
        if (el) el.value = value;
    }
            function validarPermisoRegistrarCaballo() {
            const esPropietario = '@User.IsInRole("1")'.toLowerCase() === 'true';

            if (!esPropietario) {
                alert('No posee permisos para registrar caballos.');
                return;
            }

            const modal = new bootstrap.Modal(document.getElementById('insertarCaballoModal'));
            modal.show();
        }
</script>
}

@model IEnumerable<ProyectoHipodromoGrupoF.Modelo.Veterinario>
@{
    ViewData["Title"] = "Personal Veterinario";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-secondary m-0">Registro de médicos veterinarios autorizados en el hipódromo.</p>
    @if(User.IsInRole("2"))
    {
        <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#nuevoVeterinarioModal">
            <i class="fa-solid fa-user-doctor me-2"></i> Nuevo Veterinario
        </button>
    }
</div>

<!-- Nav Tabs -->
<ul class="nav nav-pills mb-4 border-bottom border-secondary pb-3">
  <li class="nav-item">
    <a class="nav-link text-secondary" asp-action="Index">Usuarios del Sistema</a>
  </li>
  <li class="nav-item">
    <a class="nav-link text-secondary" asp-action="Propietarios">Directorio de Propietarios</a>
  </li>
  <li class="nav-item">
    <a class="nav-link active bg-transparent text-primary fw-bold" asp-action="Veterinarios">Personal Veterinario</a>
  </li>
</ul>

<div class="glass-panel p-4">
    <table class="table table-glass w-100">
        <thead>
            <tr>
                <th>Código Licencia</th>
                <th>Cédula</th>
                <th>Especialidad</th>
             
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Codigo</td>
                    <td>@item.Cedula</td>
                    <td><i class="fa-solid fa-stethoscope text-secondary me-2"></i>@item.Especialidad</td>
                 
                    <td class="text-end">
                        @if(User.IsInRole("2"))
                        {
                            <form asp-action="EliminarVeterinario" method="post" style="display:inline;"
                                  onsubmit="return confirm('¿Eliminar al veterinario @item.Codigo?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="codigo" value="@item.Codigo" />
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Nuevo Veterinario -->
@if(User.IsInRole("2"))
{
<div class="modal fade" id="nuevoVeterinarioModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content glass-card border-0">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Registrar Veterinario</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form asp-action="InsertarVeterinario" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label text-white">Cédula (Persona existente)</label>
            <input type="text" name="Cedula" class="form-control form-control-glass" required maxlength="10">
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Especialidad</label>
            <input type="text" name="Especialidad" class="form-control form-control-glass" required maxlength="100">
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Fecha de Contratación</label>
            <input type="date" name="FechaContratacion" class="form-control form-control-glass" required value="@DateTime.Today.ToString("yyyy-MM-dd")">
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary-custom">Registrar Veterinario</button>
        </div>
      </form>
    </div>
  </div>
</div>
}

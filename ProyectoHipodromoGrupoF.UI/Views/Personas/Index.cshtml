@model IEnumerable<ProyectoHipodromoGrupoF.Modelo.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var personas = ViewBag.Personas as List<ProyectoHipodromoGrupoF.Modelo.Persona> ?? new();
    var provincias = ViewBag.Provincias as List<ProyectoHipodromoGrupoF.Modelo.CatProvincia> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-secondary m-0">Administración de acceso al sistema y roles de usuario.</p>
    @if (User.IsInRole("2"))
    {
        <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#nuevoUsuarioModal">
            <i class="fa-solid fa-user-plus me-2"></i> Nuevo Usuario
        </button>
    }
</div>

<div class="d-flex gap-4 border-bottom border-secondary mb-4 pb-3">
    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Personas" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Personas">Personas</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Index">Usuarios del Sistema</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Propietarios" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Propietarios">Directorio de Propietarios</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Administradores" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Administradores">Administradores</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Veterinarios" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Veterinarios">Personal Veterinario</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Encargados" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Encargados">Encargados de Establo</a>
</div>

<div class="glass-panel p-4">
    <table class="table table-glass w-100">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre Real</th>
                <th>Cédula</th>
                <th>Usuario</th>
                <th>Rol</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var persona = personas.FirstOrDefault(p => p.Cedula == item.Cedula);
                var nombreReal = persona != null ? $"{persona.Nombre1} {persona.Apellido1}" : "Desconocido";

                <tr>
                    <td class="fw-bold">@item.Codigo</td>
                    <td><span class="text-secondary">@nombreReal</span></td>
                    <td>@item.Cedula</td>
                    <td><i class="fa-solid fa-user text-secondary me-2"></i>@item.Nombre</td>
                    <td>
                        @if (item.IdCatRol == 1)
                        {
                            <span class="badge bg-primary">Propietario</span>
                        }
                        else if (item.IdCatRol == 2)
                        {

                            <span class="badge bg-danger">Administrador</span>
                        }
                        else if (item.IdCatRol == 3)
                        {

                            <span class="badge bg-info text-dark">Encargado Establo</span>
                        }
                        else if (item.IdCatRol == 4)
                        {

                            <span class="badge bg-success">Veterinario</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary">Sin rol</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole("2"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger border-0"
                                    onclick="confirmarEliminarUsuario('@item.Codigo', '@item.Nombre')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-secondary py-5">
                        No hay usuarios registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (User.IsInRole("2"))
{
    <div class="modal fade" id="nuevoUsuarioModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content glass-card border-0">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Registrar Usuario</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <form asp-action="InsertarUsuario" method="post">
                    @Html.AntiForgeryToken()

                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label text-white">Persona con rol definido *</label>
                                <select name="Cedula"
                                        class="form-control form-control-glass"
                                        required
                                        id="selectPersonaUsuario"
                                        onchange="cargarDatosUsuarioAutomatico(this)">
                                    <option value="">— Seleccione una persona —</option>

                                    @foreach (var p in ViewBag.PersonasConRol)
                                    {
                                        <option value="@p.Cedula"
                                                data-usuario="@p.NombreUsuario"
                                                data-rol="@p.Rol"
                                                data-idrol="@p.IdCatRol">
                                            @p.NombreCompleto (@p.Cedula)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-white">Nombre de Usuario</label>
                                <input type="text"
                                       name="Nombre"
                                       id="inputNombreUsuarioAuto"
                                       class="form-control form-control-glass"
                                       readonly>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-white">Contraseña *</label>
                                <input type="password"
                                       name="Contrasena"
                                       class="form-control form-control-glass"
                                       required
                                       maxlength="50">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-white">Rol del Sistema</label>
                                <input type="text"
                                       id="inputRolUsuarioAuto"
                                       class="form-control form-control-glass"
                                       readonly>

                                <input type="hidden"
                                       name="IdCatRol"
                                       id="inputIdRolUsuarioAuto">
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit" class="btn btn-primary-custom">
                            Guardar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<div class="modal fade" id="eliminarUsuarioModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content glass-card border-0">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">
                    <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                    Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="text-white mb-0">¿Está seguro que desea eliminar este usuario?</p>
                <p class="text-secondary mt-2 mb-0">
                    Usuario seleccionado:
                    <strong class="text-white" id="usuarioEliminarTexto"></strong>
                </p>
            </div>

            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>

                <form asp-action="EliminarUsuario" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="codigo" id="codigoUsuarioEliminar" />

                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-trash me-1"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminarUsuario(codigo, nombre) {
            document.getElementById('codigoUsuarioEliminar').value = codigo;
            document.getElementById('usuarioEliminarTexto').innerText = nombre;

            const modal = new bootstrap.Modal(document.getElementById('eliminarUsuarioModal'));
            modal.show();
        }
            function cargarDatosUsuarioAutomatico(select) {
            const option = select.options[select.selectedIndex];

            if (!option.value) {
                document.getElementById('inputNombreUsuarioAuto').value = '';
                document.getElementById('inputRolUsuarioAuto').value = '';
                document.getElementById('inputIdRolUsuarioAuto').value = '';
                return;
            }

            document.getElementById('inputNombreUsuarioAuto').value = option.dataset.usuario;
            document.getElementById('inputRolUsuarioAuto').value = option.dataset.rol;
            document.getElementById('inputIdRolUsuarioAuto').value = option.dataset.idrol;
        }
    </script>
}
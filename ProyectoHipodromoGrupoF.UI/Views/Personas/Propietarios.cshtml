@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Directorio de Propietarios";
    var provincias = ViewBag.Provincias as List<ProyectoHipodromoGrupoF.Modelo.CatProvincia> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-secondary m-0">Registro de dueños de caballos y sus beneficios activos.</p>
    @if (User.IsInRole("2"))
    {
        <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#nuevoPropietarioModal">
            <i class="fa-solid fa-plus me-2"></i> Registrar Propietario
        </button>
    }
</div>

<div class="d-flex gap-4 border-bottom border-secondary mb-4 pb-3">
    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Personas" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Personas">Personas</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Index">Usuarios del Sistema</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Propietarios" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Propietarios">Directorio de Propietarios</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Administradores" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Administradores">Administradores</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Veterinarios" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Veterinarios">Personal Veterinario</a>

    <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Encargados" ? "text-primary fw-bold" : "text-secondary") text-decoration-none"
       asp-controller="Personas" asp-action="Encargados">Encargados de Establo</a>
</div>

<div class="glass-panel p-4">
    <table class="table table-glass w-100">
        <thead>
            <tr>
                <th>Código Propietario</th>
                <th>Cédula</th>
                <th>Nombre Completo</th>
                <th>Beneficio Activo</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold text-accent">@item.Codigo</td>
                    <td>@item.Cedula</td>
                    <td>@item.Nombre</td>
                    <td>
                        @if (item.Descuento)
                        {
                            <span class="badge badge-active">
                                <i class="fa-solid fa-tag me-1"></i> 10% Descuento
                            </span>
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole("2"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger border-0"
                                    onclick="confirmarEliminarPropietario('@item.Codigo', '@item.Nombre')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-secondary py-5">
                        No hay propietarios registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (User.IsInRole("2"))
{
    <div class="modal fade" id="nuevoPropietarioModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content glass-card border-0">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Registrar Propietario</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <form asp-action="InsertarPropietario" method="post">
                    @Html.AntiForgeryToken()

                    <div class="modal-body">
                        <div class="alert alert-info">
                            Seleccione una persona que aún no tenga rol asignado.
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-white">Persona *</label>
                            <select name="Cedula" class="form-control form-control-glass" required>
                                <option value="">— Seleccione una persona —</option>
                                @foreach (var p in ViewBag.PersonasSinRol)
                                {
                                    <option value="@p.Cedula">
                                        @p.NombreCompleto (@p.Cedula)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="form-check mt-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="DescuentoProximaFacturacion"
                                   value="true"
                                   id="checkDescuentoPropietario">

                            <label class="form-check-label text-white" for="checkDescuentoPropietario">
                                Otorgar 10% de descuento en su próxima factura de inmediato
                            </label>
                        </div>
                    </div>

                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary-custom">Registrar Propietario</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="eliminarPropietarioModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content glass-card border-0">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">
                    <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                    Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="text-white mb-0">¿Está seguro que desea eliminar este propietario?</p>
                <p class="text-secondary mt-2 mb-0">
                    Propietario seleccionado:
                    <strong class="text-white" id="propietarioEliminarTexto"></strong>
                </p>
            </div>

            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>

                <form asp-action="EliminarPropietario" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="codigo" id="codigoPropietarioEliminar" />

                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-trash me-1"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminarPropietario(codigo, nombre) {
            document.getElementById('codigoPropietarioEliminar').value = codigo;
            document.getElementById('propietarioEliminarTexto').innerText = nombre;

            const modal = new bootstrap.Modal(document.getElementById('eliminarPropietarioModal'));
            modal.show();
        }
    </script>
}
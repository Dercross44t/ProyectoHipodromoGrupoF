@model IEnumerable<ProyectoHipodromoGrupoF.Modelo.Proveedor>
@{
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-secondary m-0">Administración de proveedores para suministros e inventario.</p>
    <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#nuevoProveedorModal">
        <i class="fa-solid fa-truck-fast me-2"></i> Nuevo Proveedor
    </button>
</div>

<div class="glass-panel p-4">
    <table class="table table-glass w-100">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre del Proveedor</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary border-0 me-1"
                                onclick="abrirEditarProveedor('@item.Codigo','@item.Nombre')"
                                id="btnEditarProv_@item.Codigo">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <form asp-action="EliminarProveedor" method="post" style="display:inline;"
                              onsubmit="return confirm('¿Está seguro de eliminar al proveedor @item.Nombre?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="codigo" value="@item.Codigo" />
                            <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if(!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center text-secondary py-4">No hay proveedores registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Nuevo Proveedor -->
<div class="modal fade" id="nuevoProveedorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content glass-card border-0">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white"><i class="fa-solid fa-truck-fast text-primary me-2"></i>Nuevo Proveedor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="InsertarProveedor" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white">Nombre del Proveedor *</label>
                        <input type="text" name="Nombre" class="form-control form-control-glass" required maxlength="50" autocomplete="off">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom"><i class="fa-solid fa-save me-1"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Proveedor -->
<div class="modal fade" id="editarProveedorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content glass-card border-0">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white"><i class="fa-solid fa-pen text-primary me-2"></i>Editar Proveedor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ActualizarProveedor" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="Codigo" id="editProvCodigo" />
                    <div class="mb-3">
                        <label class="form-label text-white">Nombre del Proveedor *</label>
                        <input type="text" name="Nombre" id="editProvNombre" class="form-control form-control-glass" required maxlength="50" autocomplete="off">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom"><i class="fa-solid fa-save me-1"></i> Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirEditarProveedor(codigo, nombre) {
            document.getElementById('editProvCodigo').value = codigo;
            document.getElementById('editProvNombre').value = nombre;
            var modal = new bootstrap.Modal(document.getElementById('editarProveedorModal'));
            modal.show();
        }
    </script>
}
